DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Optional. Number of completed recording-session directories to retain.
# The default is 5. Older completed sessions are removed before a new one begins.
# RECORDING_RETENTION_COUNT=5

# Optional. VexBot's transcript attachment ceiling in bytes; defaults to 16 MiB.
# Set this explicitly to a limit supported by the bot's Discord server/account.
# DISCORD_TRANSCRIPT_UPLOAD_LIMIT_BYTES=16777216

# Set both paths to enable local Whisper transcription after /stop.
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=

# Optional. Inferred from standard model filenames, e.g. base.en.
# WHISPER_DTW_PRESET=base.en

# Optional. Defaults are ffmpeg and en.
# FFMPEG_PATH=ffmpeg
# WHISPER_LANGUAGE=en
